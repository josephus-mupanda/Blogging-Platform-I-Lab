<?xml version="1.0" encoding="UTF-8"?>

<!--
  The main window, shown after sign in:
  a sidebar menu on the left, a top bar, and the content area where the screens are swapped.
  Controller: org.example.bloggingplatformi.ui.AppShell
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.bloggingplatformi.ui.AppShell">

    <!-- ===================== Sidebar ===================== -->
    <left>
        <VBox styleClass="sidebar">
            <HBox spacing="11" alignment="CENTER_LEFT" styleClass="sidebar-brand">
                <StackPane styleClass="sidebar-brand-mark"><Label text="B"/></StackPane>
                <VBox>
                    <Label text="Blogfold" styleClass="sidebar-brand-title"/>
                    <Label text="Content workspace" styleClass="sidebar-brand-subtitle"/>
                </VBox>
            </HBox>

            <VBox spacing="3">
                <padding><Insets right="12" left="12"/></padding>

                <Label text="WORKSPACE" styleClass="sidebar-section-label"/>
                <Button fx:id="dashboardNav" text="Dashboard" styleClass="nav-item"
                        maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#openDashboard"/>
                <Button fx:id="postsNav" text="Posts" styleClass="nav-item"
                        maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#openPosts"/>

                <!-- Admin only: the controller hides this whole section for other users. -->
                <VBox fx:id="manageSection" spacing="3">
                    <Label text="MANAGE" styleClass="sidebar-section-label"/>
                    <Button fx:id="moderationNav" text="Moderation" styleClass="nav-item"
                            maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#openModeration"/>
                    <Button fx:id="authorsNav" text="Authors" styleClass="nav-item"
                            maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#openAuthors"/>
                    <Button fx:id="tagsNav" text="Tags" styleClass="nav-item"
                            maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#openTags"/>
                </VBox>
            </VBox>
        </VBox>
    </left>

    <!-- ===================== Main area ===================== -->
    <center>
        <VBox styleClass="content-area">

            <!-- Top bar: back button, screen title, screen buttons, signed-in user. -->
            <HBox spacing="12" alignment="CENTER_LEFT" styleClass="topbar">
                <Button fx:id="backButton" styleClass="btn-ghost, btn-small"
                        visible="false" managed="false" onAction="#back"/>
                <VBox spacing="1" alignment="CENTER_LEFT">
                    <Label fx:id="headingLabel" styleClass="text-title"/>
                    <Label fx:id="subheadingLabel" styleClass="text-small"
                           visible="false" managed="false"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <!-- Each screen puts its own buttons here (for example "New post"). -->
                <HBox fx:id="actionBar" spacing="9" alignment="CENTER_RIGHT"/>

                <HBox spacing="9" alignment="CENTER_RIGHT">
                    <padding><Insets left="10"/></padding>
                    <StackPane fx:id="avatarSlot"/>
                    <VBox alignment="CENTER_LEFT">
                        <Label fx:id="userNameLabel" styleClass="text-body"/>
                        <Label fx:id="userRoleLabel" styleClass="text-caption"/>
                    </VBox>
                    <Button text="Sign out" styleClass="btn-secondary, btn-small" onAction="#signOut"/>
                </HBox>
            </HBox>

            <!-- A message such as "Cannot reach MongoDB". Hidden when empty. -->
            <VBox fx:id="bannerSlot" visible="false" managed="false" minHeight="-Infinity">
                <padding><Insets top="16" right="26" left="26"/></padding>
            </VBox>

            <!-- The current screen is placed here. -->
            <StackPane fx:id="contentHost" VBox.vgrow="ALWAYS"/>
        </VBox>
    </center>
</BorderPane>
