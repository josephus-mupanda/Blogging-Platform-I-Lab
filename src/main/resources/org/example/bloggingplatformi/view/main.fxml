<?xml version="1.0" encoding="UTF-8"?>

<!-- The main window after sign in: a menu on the left, a top bar, and the current screen in the middle. -->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.bloggingplatformi.controller.MainController">

    <!-- Menu -->
    <left>
        <VBox spacing="6" styleClass="sidebar">
            <padding><Insets top="20" right="14" bottom="20" left="14"/></padding>
            <Label text="Blogfold" styleClass="sidebar-brand"/>
            <Button fx:id="dashboardButton" text="Dashboard" styleClass="nav" maxWidth="Infinity" onAction="#showDashboard"/>
            <Button fx:id="postsButton" text="Posts" styleClass="nav" maxWidth="Infinity" onAction="#showPosts"/>
            <!-- Admin only: hidden for bloggers and readers. -->
            <Button fx:id="tagsButton" text="Tags" styleClass="nav" maxWidth="Infinity" onAction="#showTags"/>
            <Button fx:id="usersButton" text="Users" styleClass="nav" maxWidth="Infinity" onAction="#showUsers"/>
        </VBox>
    </left>

    <center>
        <VBox>
            <!-- Top bar: screen title, who is signed in, Sign out -->
            <HBox spacing="12" alignment="CENTER_LEFT" styleClass="topbar">
                <Label fx:id="screenTitle" styleClass="title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="userLabel"/>
                <Button text="Sign out" onAction="#signOut"/>
            </HBox>
            <!-- The current screen is put here by the controller. -->
            <StackPane fx:id="content" VBox.vgrow="ALWAYS" styleClass="page"/>
        </VBox>
    </center>
</BorderPane>
