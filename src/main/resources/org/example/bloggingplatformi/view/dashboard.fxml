<?xml version="1.0" encoding="UTF-8"?>

<!-- Dashboard (analytics): how many rows there are, the latest posts and the most used tags. -->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.bloggingplatformi.controller.DashboardController"
      spacing="20">
    <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

    <!-- The counts -->
    <HBox spacing="14">
        <VBox styleClass="card" HBox.hgrow="ALWAYS"><Label text="Posts"/><Label fx:id="postsCount" styleClass="number"/></VBox>
        <VBox styleClass="card" HBox.hgrow="ALWAYS"><Label text="Comments"/><Label fx:id="commentsCount" styleClass="number"/></VBox>
        <VBox styleClass="card" HBox.hgrow="ALWAYS"><Label text="Reviews"/><Label fx:id="reviewsCount" styleClass="number"/></VBox>
        <VBox styleClass="card" HBox.hgrow="ALWAYS"><Label text="Users"/><Label fx:id="usersCount" styleClass="number"/></VBox>
        <VBox styleClass="card" HBox.hgrow="ALWAYS"><Label text="Tags"/><Label fx:id="tagsCount" styleClass="number"/></VBox>
    </HBox>

    <HBox spacing="14" VBox.vgrow="ALWAYS">
        <VBox spacing="8" styleClass="card" HBox.hgrow="ALWAYS">
            <Label text="Latest posts" styleClass="subtitle"/>
            <ListView fx:id="latestPosts" VBox.vgrow="ALWAYS"/>
        </VBox>
        <VBox spacing="8" styleClass="card" prefWidth="320">
            <Label text="Most used tags" styleClass="subtitle"/>
            <ListView fx:id="topTags" VBox.vgrow="ALWAYS"/>
        </VBox>
    </HBox>
</VBox>
