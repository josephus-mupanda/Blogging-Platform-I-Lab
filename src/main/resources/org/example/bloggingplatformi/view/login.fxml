<?xml version="1.0" encoding="UTF-8"?>

<!-- Sign in / sign up screen. Two cards on top of each other: the controller shows one at a time. -->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="org.example.bloggingplatformi.controller.LoginController"
           styleClass="page">

    <!-- Sign in -->
    <VBox fx:id="signInCard" spacing="12" styleClass="card" maxWidth="380" maxHeight="-Infinity">
        <padding><Insets top="28" right="28" bottom="28" left="28"/></padding>
        <Label text="Blogfold" styleClass="brand"/>
        <Label text="Sign in" styleClass="title"/>

        <Label text="Username" styleClass="field-label"/>
        <TextField fx:id="loginUsername" promptText="Username"/>
        <Label text="Password" styleClass="field-label"/>
        <PasswordField fx:id="loginPassword" promptText="Password" onAction="#signIn"/>

        <Label fx:id="message" styleClass="success-text" wrapText="true"/>
        <Label fx:id="signInError" styleClass="error-text" wrapText="true"/>

        <Button fx:id="signInButton" text="Sign in" styleClass="primary" maxWidth="Infinity" onAction="#signIn"/>
        <!-- Spins while the password is being checked. -->
        <ProgressIndicator fx:id="spinner" visible="false" prefWidth="24" prefHeight="24"/>
        <Button text="No account yet? Sign up" styleClass="link" onAction="#showSignUp"/>
    </VBox>

    <!-- Sign up -->
    <VBox fx:id="signUpCard" spacing="10" styleClass="card" maxWidth="380" maxHeight="-Infinity" visible="false">
        <padding><Insets top="28" right="28" bottom="28" left="28"/></padding>
        <Label text="Blogfold" styleClass="brand"/>
        <Label text="Create an account" styleClass="title"/>

        <Label text="Your name" styleClass="field-label"/>
        <TextField fx:id="signupName" promptText="Your name"/>
        <Label text="Username" styleClass="field-label"/>
        <TextField fx:id="signupUsername" promptText="At least 3 characters"/>
        <Label text="Email" styleClass="field-label"/>
        <TextField fx:id="signupEmail" promptText="you@example.com"/>
        <Label text="Password" styleClass="field-label"/>
        <PasswordField fx:id="signupPassword" promptText="At least 6 characters"/>

        <Label text="I am a" styleClass="field-label"/>
        <fx:define><ToggleGroup fx:id="roleGroup"/></fx:define>
        <RadioButton fx:id="bloggerChoice" text="Blogger (I write posts)" toggleGroup="$roleGroup"/>
        <RadioButton text="Reader (I comment and review)" toggleGroup="$roleGroup" selected="true"/>

        <Label fx:id="signUpError" styleClass="error-text" wrapText="true"/>
        <Button text="Create account" styleClass="primary" maxWidth="Infinity" onAction="#signUp"/>
        <Button text="Already have an account? Sign in" styleClass="link" onAction="#showSignIn"/>
    </VBox>
</StackPane>
