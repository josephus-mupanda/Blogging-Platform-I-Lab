<?xml version="1.0" encoding="UTF-8"?>

<!-- Tags (admin only): add and delete tags, and see how many posts use each one. -->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.bloggingplatformi.controller.TagsController"
      spacing="14">
    <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

    <VBox spacing="8" styleClass="card" HBox.hgrow="ALWAYS">
        <Label text="All tags (sorted with our merge sort)" styleClass="subtitle"/>
        <ListView fx:id="tagList" VBox.vgrow="ALWAYS"/>
        <HBox spacing="8">
            <TextField fx:id="nameField" promptText="New tag name" onAction="#addTag"/>
            <Button text="Add" styleClass="primary" onAction="#addTag"/>
            <Button text="Delete selected" styleClass="danger" onAction="#deleteTag"/>
        </HBox>
        <Label fx:id="errorLabel" styleClass="error-text"/>
    </VBox>

    <VBox spacing="8" styleClass="card" prefWidth="320">
        <Label text="Posts per tag" styleClass="subtitle"/>
        <ListView fx:id="usageList" VBox.vgrow="ALWAYS"/>
    </VBox>
</HBox>
