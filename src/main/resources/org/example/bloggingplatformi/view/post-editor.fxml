<?xml version="1.0" encoding="UTF-8"?>

<!-- Post editor: the same form creates a new post or edits an existing one. -->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.bloggingplatformi.controller.PostEditorController"
      spacing="10" styleClass="card">
    <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

    <Label text="Title" styleClass="field-label"/>
    <TextField fx:id="titleField" promptText="A clear title"/>

    <Label text="Text" styleClass="field-label"/>
    <TextArea fx:id="bodyArea" promptText="Write the post..." wrapText="true" VBox.vgrow="ALWAYS"/>

    <Label text="Tags (separated by commas, for example: java, sql)" styleClass="field-label"/>
    <TextField fx:id="tagsField" promptText="java, sql"/>

    <!-- A validation message, for example "A post needs a title." -->
    <Label fx:id="errorLabel" styleClass="error-text" wrapText="true"/>

    <HBox spacing="10">
        <Button text="Save" styleClass="primary" onAction="#save"/>
        <Button text="Cancel" onAction="#cancel"/>
    </HBox>
</VBox>
