<?xml version="1.0" encoding="UTF-8"?>

<!-- Post editor: the same form creates a new post or edits an existing one. -->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.bloggingplatformi.controller.PostEditorController"
            fitToWidth="true" hbarPolicy="NEVER" styleClass="content-scroll">
    <VBox>
        <padding><Insets top="20" right="24" bottom="24" left="24"/></padding>
        <VBox spacing="18" styleClass="card">
            <VBox spacing="6">
                <Label text="Title" styleClass="field-label"/>
                <TextField fx:id="titleField" promptText="Give your post a title" accessibleText="Post title"/>
                <Label fx:id="titleError" styleClass="error-text" wrapText="true" managed="${titleError.visible}"/>
            </VBox>

            <VBox spacing="6">
                <Label text="Post content" styleClass="field-label"/>
                <TextArea fx:id="bodyArea" promptText="Write your post…" accessibleText="Post content"
                          prefRowCount="10" wrapText="true"/>
                <Label fx:id="bodyError" styleClass="error-text" wrapText="true" managed="${bodyError.visible}"/>
            </VBox>

            <VBox spacing="8" styleClass="form-section">
                <Label text="Tags" styleClass="subtitle"/>
                <Label text="Choose existing tags to help readers find this post." styleClass="small" wrapText="true"/>
                <FlowPane fx:id="selectedTagsPane" hgap="8" vgap="8" managed="${selectedTagsPane.visible}"/>
                <ComboBox fx:id="tagPicker" promptText="Add an existing tag" accessibleText="Add an existing tag"
                          prefWidth="230" onAction="#addSelectedTag"/>
                <Label fx:id="tagStatus" styleClass="small" wrapText="true"
                       managed="${tagStatus.visible}"/>
                <Label fx:id="tagError" styleClass="error-text" wrapText="true" managed="${tagError.visible}"/>
            </VBox>

            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button text="Cancel" onAction="#cancel"/>
                <Button text="Save post" styleClass="primary" onAction="#save"/>
            </HBox>
        </VBox>
    </VBox>
</ScrollPane>
