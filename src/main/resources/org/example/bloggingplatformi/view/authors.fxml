<?xml version="1.0" encoding="UTF-8"?>

<!--
  Authors screen (admin only): every registered account, with deactivate / reactivate.
  The columns are declared here; what each cell shows is set in the controller.
  Controller: org.example.bloggingplatformi.controller.AuthorsController
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.bloggingplatformi.controller.AuthorsController"
      spacing="16">
    <padding><Insets top="24" right="26" bottom="28" left="26"/></padding>

    <VBox styleClass="card-flush" VBox.vgrow="ALWAYS">
        <TableView fx:id="table" VBox.vgrow="ALWAYS">
            <placeholder><Label text="No accounts found." styleClass="text-small"/></placeholder>
            <columns>
                <TableColumn fx:id="personColumn" text="ACCOUNT" prefWidth="280" sortable="false"/>
                <TableColumn fx:id="emailColumn" text="EMAIL" prefWidth="240" sortable="false"/>
                <TableColumn fx:id="roleColumn" text="ROLE" prefWidth="110" sortable="false"/>
                <TableColumn fx:id="statusColumn" text="STATUS" prefWidth="120" sortable="false"/>
                <TableColumn fx:id="actionsColumn" text="" prefWidth="190" sortable="false"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
