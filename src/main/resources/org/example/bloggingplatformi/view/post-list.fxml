<?xml version="1.0" encoding="UTF-8"?>

<!-- Search, filter, and open post cards. -->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.bloggingplatformi.controller.PostListController"
      spacing="14">
    <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

    <VBox spacing="12" styleClass="card">
        <HBox spacing="10" alignment="CENTER_LEFT">
            <TextField fx:id="searchField" promptText="Search titles and post content"
                       accessibleText="Search posts" onAction="#searchOnEnter" HBox.hgrow="ALWAYS"/>
            <Button text="Search" styleClass="primary" onAction="#search"/>
        </HBox>
        <FlowPane hgap="10" vgap="8" rowValignment="CENTER">
            <Label text="Filter by" styleClass="small"/>
            <ComboBox fx:id="authorBox" promptText="All authors" accessibleText="Filter by author" prefWidth="165"/>
            <ComboBox fx:id="tagBox" promptText="All tags" accessibleText="Filter by tag" prefWidth="145"/>
            <Button text="Clear filters" styleClass="link" onAction="#clearFilters"/>
        </FlowPane>
    </VBox>

    <ScrollPane fx:id="resultsScroll" fitToWidth="true" hbarPolicy="NEVER" styleClass="content-scroll" VBox.vgrow="ALWAYS">
        <VBox>
            <Label fx:id="emptyResults" text="No posts found. Try a different search or clear the filters."
                   styleClass="empty-state" maxWidth="Infinity" wrapText="true"
                   visible="false" managed="${emptyResults.visible}"/>
            <VBox fx:id="postCards" spacing="10"/>
        </VBox>
    </ScrollPane>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <!-- Hidden for readers. -->
        <Button fx:id="newButton" text="New post" styleClass="primary" onAction="#newPost"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="previousButton" text="Previous" onAction="#previousPage"/>
        <Label fx:id="pageLabel"/>
        <Button fx:id="nextButton" text="Next" onAction="#nextPage"/>
    </HBox>
</VBox>
